# Hand-written Ninja build for the "Pro54" plugin: a VST3, and optionally a CLAP.
#
# There is no configure step: JUCE module sources are referenced directly out
# of ext/JUCE, compiled as plain translation units (the same amalgamated
# per-module .cpp/.c files the Projucer normally wraps), and linked into a
# single shared object per plugin format. Re-run `ninja` after editing this
# file.
#
#   ninja                builds build/Pro54.vst3
#   ninja install        also copies it into ~/.vst3
#   ninja clap           builds build/Pro54.clap
#   ninja install-clap   also copies it into ~/.clap
#
# The CLAP targets want ext/clap, ext/clap-helpers and ext/clap-juce-extensions
# as well as ext/JUCE. Nothing else looks for them.

juce_dir = ext/JUCE/modules
vst3_sdk = $juce_dir/juce_audio_processors_headless/format_types/VST3_SDK
obj_dir = build/obj
bundle_dir = build/Pro54.vst3
binary_dir = Pro54.vst3/Contents/x86_64-linux

cxx = g++
cc = gcc

# --- preprocessor defines shared by every translation unit ---------------
module_defines = -DJUCE_MODULE_AVAILABLE_juce_core=1 -DJUCE_MODULE_AVAILABLE_juce_events=1 -DJUCE_MODULE_AVAILABLE_juce_data_structures=1 -DJUCE_MODULE_AVAILABLE_juce_graphics=1 -DJUCE_MODULE_AVAILABLE_juce_gui_basics=1 -DJUCE_MODULE_AVAILABLE_juce_gui_extra=1 -DJUCE_MODULE_AVAILABLE_juce_audio_basics=1 -DJUCE_MODULE_AVAILABLE_juce_audio_processors=1 -DJUCE_MODULE_AVAILABLE_juce_audio_processors_headless=1 -DJUCE_MODULE_AVAILABLE_juce_audio_plugin_client=1

feature_defines = -DLINUX=1 -DNDEBUG=1 -DJUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1 -DJUCE_STRICT_REFCOUNTEDPOINTER=1 -DJUCE_WEB_BROWSER=0 -DJUCE_USE_CURL=0 -DJUCE_VST3_CAN_REPLACE_VST2=0

defines = $module_defines $feature_defines -include src/JucePluginDefines.h

includes = -I$juce_dir -I$vst3_sdk -Isrc

clap_wrapper = ext/clap-juce-extensions
clap_includes = -Iext/clap/include -Iext/clap-helpers/include -I$clap_wrapper/include

pkg_cflags = $$(pkg-config --cflags freetype2 fontconfig)
pkg_libs = $$(pkg-config --libs freetype2 fontconfig)

# There's no debug info, and each function gets a section of its own so that
# the linker can throw away the (large) part of JUCE that this never calls.
common_flags = -fPIC -fvisibility=hidden -O2 -ffunction-sections -fdata-sections $defines $includes $pkg_cflags

# --- rules -----------------------------------------------------------------
rule cxx
  depfile = $out.d
  deps = gcc
  command = $cxx -MMD -MF $out.d -std=c++17 -fvisibility-inlines-hidden $common_flags $extra -c $in -o $out
  description = CXX $in

rule cc
  depfile = $out.d
  deps = gcc
  command = $cc -MMD -MF $out.d $common_flags -c $in -o $out
  description = CC $in

rule link
  command = $cxx -shared -fPIC -fvisibility=hidden -Wl,--gc-sections -Wl,--no-undefined -s -o $out $in $pkg_libs -lrt -ldl -lpthread
  description = LINK $out

rule copy
  command = mkdir -p $$(dirname $out) && cp $in $out
  description = COPY $out

rule install
  command = mkdir -p $$HOME/.vst3/$binary_dir && cp $in $$HOME/.vst3/$binary_dir/
  description = INSTALL ~/.vst3/Pro54.vst3

rule install_clap
  command = mkdir -p $$HOME/.clap && cp $in $$HOME/.clap/
  description = INSTALL ~/.clap/Pro54.clap

# --- our plugin sources ------------------------------------------------
# (the engine and the presets are plain C++, with no JUCE in them)
build $obj_dir/src/Pro54Engine.o: cxx src/Pro54Engine.cc
  extra = -Wall -Wextra
build $obj_dir/src/Pro54Presets.o: cxx src/Pro54Presets.cc
  extra = -Wall -Wextra
build $obj_dir/src/PluginProcessor.o: cxx src/PluginProcessor.cc
  extra = -Wall -Wextra
build $obj_dir/src/PluginEditor.o: cxx src/PluginEditor.cc
  extra = -Wall -Wextra

# --- JUCE module translation units --------------------------------------
build $obj_dir/juce_core/juce_core.o: cxx $juce_dir/juce_core/juce_core.cpp
build $obj_dir/juce_core/juce_core_CompilationTime.o: cxx $juce_dir/juce_core/juce_core_CompilationTime.cpp
build $obj_dir/juce_core/juce_core_zlib.o: cc $juce_dir/juce_core/juce_core_zlib.c

build $obj_dir/juce_events/juce_events.o: cxx $juce_dir/juce_events/juce_events.cpp

build $obj_dir/juce_data_structures/juce_data_structures.o: cxx $juce_dir/juce_data_structures/juce_data_structures.cpp

build $obj_dir/juce_graphics/juce_graphics.o: cxx $juce_dir/juce_graphics/juce_graphics.cpp
build $obj_dir/juce_graphics/juce_graphics_Harfbuzz.o: cxx $juce_dir/juce_graphics/juce_graphics_Harfbuzz.cpp
build $obj_dir/juce_graphics/juce_graphics_libjpg_1.o: cc $juce_dir/juce_graphics/juce_graphics_libjpg_1.c
build $obj_dir/juce_graphics/juce_graphics_libjpg_2.o: cc $juce_dir/juce_graphics/juce_graphics_libjpg_2.c
build $obj_dir/juce_graphics/juce_graphics_libjpg_3.o: cc $juce_dir/juce_graphics/juce_graphics_libjpg_3.c
build $obj_dir/juce_graphics/juce_graphics_libpng.o: cc $juce_dir/juce_graphics/juce_graphics_libpng.c
build $obj_dir/juce_graphics/juce_graphics_lunasvg.o: cc $juce_dir/juce_graphics/juce_graphics_lunasvg.c
build $obj_dir/juce_graphics/juce_graphics_Sheenbidi.o: cc $juce_dir/juce_graphics/juce_graphics_Sheenbidi.c

build $obj_dir/juce_gui_basics/juce_gui_basics.o: cxx $juce_dir/juce_gui_basics/juce_gui_basics.cpp
build $obj_dir/juce_gui_basics/juce_gui_basics_2.o: cxx $juce_dir/juce_gui_basics/juce_gui_basics_2.cpp
build $obj_dir/juce_gui_basics/juce_gui_basics_3.o: cxx $juce_dir/juce_gui_basics/juce_gui_basics_3.cpp
build $obj_dir/juce_gui_basics/juce_gui_basics_4.o: cxx $juce_dir/juce_gui_basics/juce_gui_basics_4.cpp
build $obj_dir/juce_gui_basics/juce_gui_basics_5.o: cxx $juce_dir/juce_gui_basics/juce_gui_basics_5.cpp

# (nothing here uses this one directly, but juce_audio_processors needs it)
build $obj_dir/juce_gui_extra/juce_gui_extra.o: cxx $juce_dir/juce_gui_extra/juce_gui_extra.cpp

build $obj_dir/juce_audio_basics/juce_audio_basics.o: cxx $juce_dir/juce_audio_basics/juce_audio_basics.cpp

build $obj_dir/juce_audio_processors/juce_audio_processors.o: cxx $juce_dir/juce_audio_processors/juce_audio_processors.cpp

build $obj_dir/juce_audio_processors_headless/juce_audio_processors_headless.o: cxx $juce_dir/juce_audio_processors_headless/juce_audio_processors_headless.cpp

build $obj_dir/juce_audio_plugin_client/juce_audio_plugin_client_VST3.o: cxx $juce_dir/juce_audio_plugin_client/juce_audio_plugin_client_VST3.cpp

# --- the CLAP wrapper (not built by default) ------------------------------
build $obj_dir/clap/clap-juce-wrapper.o: cxx $clap_wrapper/src/wrapper/clap-juce-wrapper.cpp
  extra = $clap_includes
build $obj_dir/clap/clap-juce-extensions.o: cxx $clap_wrapper/src/extensions/clap-juce-extensions.cpp
  extra = $clap_includes

# --- link ------------------------------------------------------------------
# Ninja does not split a multi-path variable into separate inputs, so the
# object list has to be spelled out explicitly, once for each format: they
# differ only in the last line or two, the format's wrapper.
build $obj_dir/Pro54.so: link $
    $obj_dir/src/Pro54Engine.o $
    $obj_dir/src/Pro54Presets.o $
    $obj_dir/src/PluginProcessor.o $
    $obj_dir/src/PluginEditor.o $
    $obj_dir/juce_core/juce_core.o $
    $obj_dir/juce_core/juce_core_CompilationTime.o $
    $obj_dir/juce_core/juce_core_zlib.o $
    $obj_dir/juce_events/juce_events.o $
    $obj_dir/juce_data_structures/juce_data_structures.o $
    $obj_dir/juce_graphics/juce_graphics.o $
    $obj_dir/juce_graphics/juce_graphics_Harfbuzz.o $
    $obj_dir/juce_graphics/juce_graphics_libjpg_1.o $
    $obj_dir/juce_graphics/juce_graphics_libjpg_2.o $
    $obj_dir/juce_graphics/juce_graphics_libjpg_3.o $
    $obj_dir/juce_graphics/juce_graphics_libpng.o $
    $obj_dir/juce_graphics/juce_graphics_lunasvg.o $
    $obj_dir/juce_graphics/juce_graphics_Sheenbidi.o $
    $obj_dir/juce_gui_basics/juce_gui_basics.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_2.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_3.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_4.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_5.o $
    $obj_dir/juce_gui_extra/juce_gui_extra.o $
    $obj_dir/juce_audio_basics/juce_audio_basics.o $
    $obj_dir/juce_audio_processors/juce_audio_processors.o $
    $obj_dir/juce_audio_processors_headless/juce_audio_processors_headless.o $
    $obj_dir/juce_audio_plugin_client/juce_audio_plugin_client_VST3.o

build build/Pro54.clap: link $
    $obj_dir/src/Pro54Engine.o $
    $obj_dir/src/Pro54Presets.o $
    $obj_dir/src/PluginProcessor.o $
    $obj_dir/src/PluginEditor.o $
    $obj_dir/juce_core/juce_core.o $
    $obj_dir/juce_core/juce_core_CompilationTime.o $
    $obj_dir/juce_core/juce_core_zlib.o $
    $obj_dir/juce_events/juce_events.o $
    $obj_dir/juce_data_structures/juce_data_structures.o $
    $obj_dir/juce_graphics/juce_graphics.o $
    $obj_dir/juce_graphics/juce_graphics_Harfbuzz.o $
    $obj_dir/juce_graphics/juce_graphics_libjpg_1.o $
    $obj_dir/juce_graphics/juce_graphics_libjpg_2.o $
    $obj_dir/juce_graphics/juce_graphics_libjpg_3.o $
    $obj_dir/juce_graphics/juce_graphics_libpng.o $
    $obj_dir/juce_graphics/juce_graphics_lunasvg.o $
    $obj_dir/juce_graphics/juce_graphics_Sheenbidi.o $
    $obj_dir/juce_gui_basics/juce_gui_basics.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_2.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_3.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_4.o $
    $obj_dir/juce_gui_basics/juce_gui_basics_5.o $
    $obj_dir/juce_gui_extra/juce_gui_extra.o $
    $obj_dir/juce_audio_basics/juce_audio_basics.o $
    $obj_dir/juce_audio_processors/juce_audio_processors.o $
    $obj_dir/juce_audio_processors_headless/juce_audio_processors_headless.o $
    $obj_dir/clap/clap-juce-wrapper.o $
    $obj_dir/clap/clap-juce-extensions.o

# --- VST3 bundle -------------------------------------------------------
build $bundle_dir/Contents/x86_64-linux/Pro54.so: copy $obj_dir/Pro54.so

build Pro54: phony $bundle_dir/Contents/x86_64-linux/Pro54.so

# (not built by default)
build install: install $bundle_dir/Contents/x86_64-linux/Pro54.so

# --- CLAP, which is a single file on Linux (not built by default) ---------
build clap: phony build/Pro54.clap
build install-clap: install_clap build/Pro54.clap

default Pro54
